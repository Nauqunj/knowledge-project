# 本地环境变量模板。复制为 .env 并填入真实值：
#   Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不会提交。CI 请改用 GitHub Secrets。

# LLM 提供商：deepseek | qwen | openai
LLM_PROVIDER=deepseek

# 与 LLM_PROVIDER 匹配的 API 密钥（只填对应那一行即可）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# 可选：GitHub Search API token（提高限速）
GITHUB_TOKEN=

# 可选：arXiv 礼貌联系邮箱
ARXIV_MAILTO=
